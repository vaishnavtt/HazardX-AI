# HAZARDX AI — Environment Configuration Template
# Copy this file to .env to configure local settings. All external scientific APIs work out-of-the-box using public endpoints.

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false
API_V1_PREFIX=/api/v1

# NASA FIRMS API Key (Optional: system automatically uses open VIIRS thermal anomaly feeds if unset)
NASA_FIRMS_MAP_KEY=

# Background Alert Monitoring Daemon
ALERT_MONITOR_ENABLED=true
ALERT_MONITOR_INTERVAL_SECONDS=180
ALERT_MAX_AGE_HOURS=48
ALERT_DEDUP_WINDOW_HOURS=12

# Background Data Ingestion Scheduler
INGESTION_SCHEDULER_ENABLED=false
INGESTION_INTERVAL_SECONDS=300

# Email Notification Service (Optional: system gracefully operates in local mock mode if unconfigured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
ALERT_EMAIL_FROM=alerts@hazardx.ai
ALERT_EMAIL_RECIPIENTS=
ALERT_EMAIL_MIN_SEVERITY=ORANGE

# Frontend API URL (Configured in frontend/.env if running on non-default port)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
